// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum AccessLevel {
  PUBLIC
  PRIVATE
  USER
}

enum Role {
  ADMIN
  USER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserStatus {
  APPROVED
  PENDING
  REJECTED
  BANNED
}

model Post {
  id              String           @id @default(cuid())
  title           String           @default("Untitled")
  content         Json
  description     String?
  readingTime     String?
  imgSrc          String?
  imgAlt          String?
  status          PostStatus       @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tags            Tag[]
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id])
  accessLevel     AccessLevel      @default(PUBLIC)
  mainPost        MainPost?
  mainMemberPost  MainMemberPost?
  recommendedPost RecommendedPost?

  @@index([status, accessLevel])
  @@index([createdAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MainPost {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pinned post shown in the member-only teaser section, independent of MainPost.
model MainMemberPost {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecommendedPost {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Backing store for the request rate limiter. A DB-backed store is required
// because in-memory counters don't survive across serverless cold starts or
// multiple concurrent instances.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  image     String?
  avatar    String?
  googleId  String?    @unique
  status    UserStatus @default(PENDING)
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
